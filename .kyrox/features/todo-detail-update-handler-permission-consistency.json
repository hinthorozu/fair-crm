  "platform_reusability": "existing_core_capability",
  "trigger": "user",
  "tenant_scope": "organization",
  "user_facing": true,
  "affected_paths": [
    "frontend/src/pages/TodoDetailPage.tsx",
    "frontend/src/permissions/TodoDetailPageUpdatePermissions.test.ts",
