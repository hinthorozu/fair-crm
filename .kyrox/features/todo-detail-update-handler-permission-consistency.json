        "assignable": true
      }
    ]
  },
  "frontend": {
    "required": true,
    "routes": ["/todos/:id"],
    "menu": false,
    "menu_permission": null
  },
  "applicability": {
    "database": { "status": "na", "reason": "No persistence changes are introduced." },
    "migration": { "status": "na", "reason": "The existing fair_crm.todos.update permission is reused." },
    "permissions": { "status": "required" },
    "backend": { "status": "na", "reason": "Existing todo update and checklist replacement authorization remains unchanged and authoritative." },
    "api": { "status": "na", "reason": "No server API contract changes." },
    "tenant_isolation": { "status": "na", "reason": "No organization-scoping behavior changes." },
    "audit": { "status": "na", "reason": "Existing todo update auditing remains unchanged." },
    "frontend": { "status": "required" },
    "ui_permissions": { "status": "required" },
    "menu": { "status": "na", "reason": "No navigation menu changes are introduced." },
    "route_guard": { "status": "na", "reason": "The todo detail route remains readable; only update mutation handling is hardened." },
    "forms": { "status": "required" },
    "visual_qa": { "status": "required" },
    "backend_tests": { "status": "na", "reason": "Backend authorization behavior is unchanged." },
    "frontend_tests": { "status": "required" },
    "runtime_authorization": { "status": "required" },
    "runtime_verification": { "status": "required" },
    "deployment": { "status": "required" }
  },
  "notes": "TodoDetailPage already exposed edit entry only with fair_crm.todos.update, but handleEditSubmit itself was not fail-closed and the edit modal could remain mounted after permission loss. The handler and modal now fail closed on the canonical update permission."
}
