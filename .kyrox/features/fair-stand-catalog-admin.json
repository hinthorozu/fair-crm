    "permissions": { "status": "required" },
    "backend": { "status": "na", "reason": "Admin mutations run on the Fair Stand API behind same-origin proxy." },
    "api": { "status": "na", "reason": "CRM no longer mounts /api/v1/fair-stand admin routes." },
    "tenant_isolation": { "status": "na", "reason": "Global Fair Stand product data; no organization_id; SYSTEM Super Admin only." },
    "audit": { "status": "na", "reason": "No new Fair CRM audit stream; mutations are Super Admin catalog administration." },
    "frontend": { "status": "required" },
    "ui_permissions": { "status": "required" },
    "menu": { "status": "required" },
    "route_guard": { "status": "required" },
    "forms": { "status": "required" },
    "visual_qa": { "status": "required" },
    "backend_tests": { "status": "na", "reason": "Admin API tests live in the Fair Stand repository; CRM asserts the routes are not hosted." },
    "frontend_tests": { "status": "required" },
    "runtime_authorization": { "status": "required" },
    "runtime_verification": { "status": "required" },
    "deployment": { "status": "required" }
