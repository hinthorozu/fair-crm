        "scope": "organization",
        "assignable": true
      },
      {
        "code": "fair_crm.mail_templates.render",
        "action": "render the selected template for preview",
        "scope": "organization",
        "assignable": true
      },
      {
        "code": "fair_crm.email_accounts.read",
        "action": "load selectable SMTP accounts for send configuration",
        "scope": "organization",
        "assignable": true
      }
    ]
  },
  "frontend": {
