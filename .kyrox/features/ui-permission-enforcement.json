{
  "version": 1,
  "id": "ui-permission-enforcement",
  "title": "Effective Permission Based UI Enforcement",
  "feature_type": "ui_only",
  "owner": "fair-crm",
  "platform_reusability": "product_specific",
  "trigger": "user",
  "tenant_scope": "mixed",
  "user_facing": true,
  "affected_paths": [
    "frontend/src/auth/AuthContext.tsx",
    "frontend/src/auth/refreshCoordinator.ts",
    "frontend/src/auth/session.ts",
    "frontend/src/auth/session.test.ts",
    "frontend/src/auth/superAdminResolver.ts",
    "frontend/src/auth/superAdminResolver.test.ts",
    "frontend/src/permissions/corePermissions.ts",
    "frontend/src/permissions/corePermissions.test.ts",
    "frontend/src/permissions/navigationPermissions.ts",
    "frontend/src/permissions/navigationPermissions.test.ts",
    "frontend/src/labels/permissionLabels.ts",
    "frontend/src/labels/uiLabels.ts",
    "frontend/src/App.tsx",
    "frontend/src/components/layout/AppLayout.tsx",
    "frontend/src/components/admin/AdminSystemLayout.tsx",
    "frontend/src/components/dataIntegration/DataIntegrationLayout.tsx",
    "frontend/src/pages/UsersAdminPage.tsx",
    "frontend/src/pages/OrganizationsPage.tsx"
  ],
  "permissions": {
    "required": true,
    "items": [
      { "code": "identity.organizations.read", "action": "read organizations", "scope": "organization", "assignable": true },
      { "code": "identity.organizations.update", "action": "update organization", "scope": "organization", "assignable": true },
      { "code": "identity.organizations.delete", "action": "delete organization", "scope": "system", "assignable": false },
      { "code": "identity.users.read", "action": "read users", "scope": "organization", "assignable": true },
      { "code": "identity.users.create", "action": "create users", "scope": "organization", "assignable": true },
      { "code": "identity.users.update", "action": "update users", "scope": "organization", "assignable": true },
      { "code": "identity.users.delete", "action": "delete users", "scope": "organization", "assignable": true },
      { "code": "identity.roles.read", "action": "read roles", "scope": "organization", "assignable": true },
      { "code": "fair_crm.customers.read", "action": "read customers", "scope": "organization", "assignable": true },
      { "code": "fair_crm.fairs.read", "action": "read fairs", "scope": "organization", "assignable": true },
      { "code": "fair_crm.todos.read", "action": "read todos", "scope": "organization", "assignable": true },
      { "code": "fair_crm.operations.read", "action": "read operations", "scope": "organization", "assignable": true },
      { "code": "fair_crm.operations.create", "action": "create operations and open operation creation routes", "scope": "organization", "assignable": true },
      { "code": "fair_crm.activities.read", "action": "read activities", "scope": "organization", "assignable": true },
      { "code": "fair_crm.imports.read", "action": "read imports", "scope": "organization", "assignable": true },
      { "code": "fair_crm.imports.create", "action": "create imports", "scope": "organization", "assignable": true },
      { "code": "fair_crm.imports.update", "action": "continue or update import workflow", "scope": "organization", "assignable": true },
      { "code": "fair_crm.scraper.read", "action": "read scraper configuration/history", "scope": "organization", "assignable": true },
      { "code": "fair_crm.admin.backups.read", "action": "read database backups", "scope": "system", "assignable": false },
      { "code": "fair_crm.email_accounts.read", "action": "read email accounts", "scope": "organization", "assignable": true },
      { "code": "fair_crm.mail_send_operations.read", "action": "read mail send operations", "scope": "organization", "assignable": true },
      { "code": "fair_crm.mail_templates.read", "action": "read mail templates", "scope": "organization", "assignable": true },
      { "code": "fair_crm.quote_templates.read", "action": "read quote templates", "scope": "organization", "assignable": true },
      { "code": "fair_crm.template_contents.read", "action": "read template contents", "scope": "organization", "assignable": true },
      { "code": "fair_crm.cost_catalog.categories.read", "action": "read cost categories", "scope": "organization", "assignable": true },
      { "code": "fair_crm.cost_catalog.products.read", "action": "read cost products", "scope": "organization", "assignable": true }
    ]
  },
  "frontend": {
    "required": true,
    "routes": [
      "/customers",
      "/fairs",
      "/todos",
      "/operations",
      "/activities",
      "/data-integration/*",
      "/admin/*"
    ],
    "menu": false,
    "menu_permission": null
  },
  "applicability": {
    "database": { "status": "na", "reason": "UI permission enforcement does not change product persistence." },
    "migration": { "status": "na", "reason": "All consumed permission codes already exist in Core; no catalog migration is introduced." },
    "permissions": { "status": "required" },
    "backend": { "status": "na", "reason": "Backend authorization already exists; this delivery aligns frontend behavior with it." },
    "api": { "status": "na", "reason": "No new API endpoint or API contract is introduced." },
    "tenant_isolation": { "status": "na", "reason": "No backend data query is changed by this UI-only delivery." },
    "audit": { "status": "na", "reason": "Visibility guards do not create business mutations or new side effects." },
    "frontend": { "status": "required" },
    "ui_permissions": { "status": "required" },
    "menu": { "status": "required" },
    "route_guard": { "status": "required" },
    "forms": { "status": "na", "reason": "Existing form semantics are unchanged; only action availability is permission-gated." },
    "visual_qa": { "status": "required" },
    "backend_tests": { "status": "na", "reason": "No backend executable behavior is changed." },
    "frontend_tests": { "status": "required" },
    "runtime_authorization": { "status": "required" },
    "runtime_verification": { "status": "required" },
    "deployment": { "status": "required" }
  },
  "notes": "Use effective permissions for normal product capabilities and Core's resolved is_super_admin identity for platform-only actions that intentionally have no permission code. Do not infer capabilities from role names. Backend authorization remains the security boundary."
}
