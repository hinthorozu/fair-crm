{
  "version": 1,
  "id": "fair-stand-shell-route",
  "title": "Fair Stand configurator shell route in Fair CRM",
  "feature_type": "ui_only",
  "owner": "fair-crm",
  "platform_reusability": "product_specific",
  "trigger": "user",
  "tenant_scope": "none",
  "user_facing": true,
  "affected_paths": [
    "frontend/src/pages/FairStandPage.tsx",
    "frontend/src/pages/FairStandPage.test.ts",
    "frontend/src/pages/FairStandCatalogProxy.test.ts",
    "frontend/src/pages/FairStandStandaloneRoute.test.ts",
    "frontend/src/pages/StandProjectsPage.tsx",
    "frontend/src/pages/StandProjectsPage.test.ts",
    "frontend/src/api/fairStandProjects.ts",
    "frontend/src/labels/standProjectsLabels.ts",
    "frontend/src/App.tsx",
    "frontend/src/components/layout/NavIcons.tsx",
    "frontend/src/components/layout/NavLink.tsx",
    "frontend/src/components/layout/NavLink.test.ts",
    "frontend/src/components/layout/AppLayout.tsx",
    "frontend/src/labels/uiLabels.ts",
    "frontend/src/permissions/navigationPermissions.ts",
    "frontend/src/permissions/navigationPermissions.test.ts",
    "frontend/src/styles.css",
    "frontend/src/utils/documentTitle.ts",
    "frontend/src/utils/documentTitle.test.ts",
    "frontend/src/vite-env.d.ts",
    "frontend/vite.config.ts",
    "frontend/scripts/capture-ui-evidence.mjs",
    "scripts/server/nginx/fair-crm.conf",
    "frontend/package.json",
    "frontend/package-lock.json",
    "frontend/src/fairStand/mountFairStand.js",
    "frontend/scripts/fair-stand-shell-acceptance.mjs",
    "scripts/server/bootstrap-server.sh",
    "scripts/server/deploy-all.sh",
    "scripts/server/check-server.sh",
    "scripts/server/lib/common.sh",
    ".kyrox/features/fair-stand-shell-route.json",
    ".kyrox/features/fair-stand-stand-projects-list.json"
  ],
  "permissions": {
    "required": true,
    "reason": "Standlar nav and configurator routes require fair_crm.fair_stand.projects.* codes.",
    "items": [
      { "code": "fair_crm.fair_stand.projects.read", "action": "read", "scope": "organization", "assignable": true },
      { "code": "fair_crm.fair_stand.projects.create", "action": "create", "scope": "organization", "assignable": true },
      { "code": "fair_crm.fair_stand.projects.update", "action": "update", "scope": "organization", "assignable": true },
      { "code": "fair_crm.fair_stand.projects.delete", "action": "delete", "scope": "organization", "assignable": true },
      { "code": "fair_crm.fair_stand.projects.execute", "action": "execute", "scope": "organization", "assignable": true }
    ]
  },
  "frontend": {
    "required": true,
    "routes": ["/stand-projects", "/stand-projects/new", "/stand-projects/:id"],
    "menu": true,
    "menu_permission": "fair_crm.fair_stand.projects.read"
  },
  "applicability": {
    "database": { "status": "na", "reason": "No Fair CRM persistence is added for the shell mount." },
    "migration": { "status": "na", "reason": "No schema or permission-catalog migration in this shell contract." },
    "permissions": { "status": "required", "reason": "Shell/editor routes require Fair Stand projects permissions; list uses read." },
    "backend": { "status": "na", "reason": "No Fair CRM backend module is added for the shell." },
    "api": { "status": "na", "reason": "Shell bootstraps via same-origin /api/v1/fair-stand proxy; CRM process does not host Stand routes." },
    "tenant_isolation": { "status": "required", "reason": "Project open/save is org-scoped via Stand API headers." },
    "audit": { "status": "na", "reason": "No Fair CRM audit stream is added." },
    "frontend": { "status": "required" },
    "ui_permissions": { "status": "required" },
    "menu": { "status": "required" },
    "route_guard": { "status": "required" },
    "forms": { "status": "na", "reason": "The shell has no Fair CRM form surface." },
    "visual_qa": { "status": "required" },
    "backend_tests": { "status": "na", "reason": "No backend production code is in this shell contract." },
    "frontend_tests": { "status": "required" },
    "runtime_authorization": { "status": "required" },
    "runtime_verification": { "status": "required" },
    "deployment": { "status": "required" }
  },
  "notes": "Legacy /fair-stand redirects to /stand-projects. Configurator mounts at /stand-projects/new and /stand-projects/:id with capability flags. List/page permissions live in fair-stand-stand-projects-list.json."
}
