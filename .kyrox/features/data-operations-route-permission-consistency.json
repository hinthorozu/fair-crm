    "routes": [
      "/operations/new/duplicate-check",
      "/operations/duplicate-check/runs/:runId",
      "/admin/data-operations",
      "/admin/data-operations/runs/:runId"
    ],
    "menu": false,
    "menu_permission": null
  },
  "applicability": {
    "database": { "status": "na", "reason": "No persistence model changes are introduced." },
    "migration": { "status": "na", "reason": "Existing permissions are reused." },
    "permissions": { "status": "required" },
    "backend": { "status": "na", "reason": "Existing data-operation and operation authorization remains unchanged and authoritative." },
    "api": { "status": "na", "reason": "No server API contract changes." },
    "tenant_isolation": { "status": "na", "reason": "No organization-scoping behavior changes." },
    "audit": { "status": "na", "reason": "No mutation or audit behavior changes." },
    "frontend": { "status": "required" },
    "ui_permissions": { "status": "required" },
    "menu": { "status": "na", "reason": "Main Operations navigation remains governed by fair_crm.operations.read." },
    "route_guard": { "status": "required" },
    "forms": { "status": "na", "reason": "No form behavior changes." },
    "visual_qa": { "status": "required" },
    "backend_tests": { "status": "na", "reason": "Backend authorization behavior is unchanged." },
    "frontend_tests": { "status": "required" },
    "runtime_authorization": { "status": "required" },
    "runtime_verification": { "status": "required" },
    "deployment": { "status": "required" }
  },
  "notes": "The duplicate-check wizard now follows the merged business boundary: fair_crm.operations.execute plus fair_crm.admin.data_operations.read. Duplicate-check result routes remain operations.read plus data-operations.read. Supported legacy /admin/data-operations creation routes intentionally retain operations.create plus data-operations.read and are outside the specialized wizard cleanup."
