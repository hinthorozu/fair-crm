        "scope": "organization",
        "assignable": true
      },
      {
        "code": "fair_crm.operations.execute",
        "action": "enter the duplicate-check wizard and run duplicate checks",
        "scope": "organization",
        "assignable": true
      },
      {
        "code": "fair_crm.operations.create",
        "action": "enter the supported legacy admin data-operations creation surface",
        "scope": "organization",
        "assignable": true
      },
      {
        "code": "fair_crm.operations.read",
        "action": "enter duplicate-check result surfaces",
        "scope": "organization",
        "assignable": true
      }
    ]
  },
  "frontend": {
