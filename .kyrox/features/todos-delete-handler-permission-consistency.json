{
  "version": 1,
  "id": "todos-delete-handler-permission-consistency",
  "title": "Todos Delete Handler Permission Consistency",
  "feature_type": "ui_only",
  "owner": "fair-crm",
  "platform_reusability": "existing_core_capability",
  "trigger": "user",
  "tenant_scope": "organization",
  "user_facing": true,
  "affected_paths": [
    "frontend/src/pages/TodosPage.tsx",
    "frontend/src/permissions/TodosPageDeletePermissions.test.ts",
    ".kyrox/features/todos-delete-handler-permission-consistency.json"
  ],
  "permissions": {
    "required": true,
    "items": [
      {
        "code": "fair_crm.todos.delete",
        "action": "archive or delete todo",
        "scope": "organization",
        "assignable": true
      }
    ]
  },
  "frontend": {
    "required": true,
    "routes": ["/todos"],
    "menu": false,
    "menu_permission": null
  },
  "applicability": {
    "database": { "status": "na", "reason": "No persistence changes are introduced." },
    "migration": { "status": "na", "reason": "The existing fair_crm.todos.delete permission is reused." },
    "permissions": { "status": "required" },
    "backend": { "status": "na", "reason": "Existing todo archive and delete authorization remains unchanged and authoritative." },
    "api": { "status": "na", "reason": "No server API contract changes." },
    "tenant_isolation": { "status": "na", "reason": "No organization-scoping behavior changes." },
    "audit": { "status": "na", "reason": "Existing todo archive/delete auditing remains unchanged." },
    "frontend": { "status": "required" },
    "ui_permissions": { "status": "required" },
    "menu": { "status": "na", "reason": "No navigation menu changes are introduced." },
    "route_guard": { "status": "na", "reason": "The todos route remains readable; only delete-class mutation handling is hardened." },
    "forms": { "status": "required" },
    "visual_qa": { "status": "required" },
    "backend_tests": { "status": "na", "reason": "Backend authorization behavior is unchanged." },
    "frontend_tests": { "status": "required" },
    "runtime_authorization": { "status": "required" },
    "runtime_verification": { "status": "required" },
    "deployment": { "status": "required" }
  },
  "notes": "TodosPage already hid archive/delete UI without fair_crm.todos.delete, but handleArchive and handleDelete themselves could invoke their APIs without explicit fail-closed guards. Both handlers now return immediately when their mapped delete permission is absent."
}
