{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kyrox.local/schemas/fair-crm-feature-contract.schema.json",
  "title": "KYROX Fair CRM Feature Contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "id",
    "title",
    "feature_type",
    "owner",
    "platform_reusability",
    "trigger",
    "tenant_scope",
    "user_facing",
    "affected_paths",
    "permissions",
    "frontend",
    "applicability"
  ],
  "properties": {
    "version": { "const": 1 },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]*$",
      "minLength": 2
    },
    "title": { "type": "string", "minLength": 2 },
    "feature_type": {
      "enum": [
        "crud_module",
        "read_only_module",
        "backend_service",
        "background_job",
        "scheduled_job",
        "user_triggered_operation",
        "integration_adapter",
        "system_admin",
        "core_platform_capability",
        "ui_only",
        "maintenance",
        "other"
      ]
    },
    "owner": { "enum": ["fair-crm", "kyrox-core"] },
    "platform_reusability": {
      "enum": ["product_specific", "platform_generic", "existing_core_capability"]
    },
    "trigger": {
      "enum": ["user", "api", "scheduled", "internal", "event", "mixed", "none"]
    },
    "tenant_scope": { "enum": ["organization", "system", "mixed", "none"] },
    "user_facing": { "type": "boolean" },
    "affected_paths": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "permissions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required", "items"],
      "properties": {
        "required": { "type": "boolean" },
        "reason": { "type": "string" },
        "items": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["code", "action", "scope", "assignable"],
            "properties": {
              "code": {
                "type": "string",
                "pattern": "^[a-z0-9_]+(?:\\.[a-z0-9_]+)+$"
              },
              "action": { "type": "string", "minLength": 1 },
              "scope": { "enum": ["organization", "system"] },
              "assignable": { "type": "boolean" }
            }
          }
        }
      }
    },
    "frontend": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required", "routes", "menu"],
      "properties": {
        "required": { "type": "boolean" },
        "reason": { "type": "string" },
        "routes": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "menu": { "type": "boolean" },
        "menu_permission": { "type": ["string", "null"] }
      }
    },
    "applicability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "database",
        "migration",
        "permissions",
        "backend",
        "api",
        "tenant_isolation",
        "audit",
        "frontend",
        "ui_permissions",
        "menu",
        "route_guard",
        "forms",
        "visual_qa",
        "backend_tests",
        "frontend_tests",
        "runtime_authorization",
        "runtime_verification",
        "deployment"
      ],
      "properties": {
        "database": { "$ref": "#/$defs/gate" },
        "migration": { "$ref": "#/$defs/gate" },
        "permissions": { "$ref": "#/$defs/gate" },
        "backend": { "$ref": "#/$defs/gate" },
        "api": { "$ref": "#/$defs/gate" },
        "tenant_isolation": { "$ref": "#/$defs/gate" },
        "audit": { "$ref": "#/$defs/gate" },
        "frontend": { "$ref": "#/$defs/gate" },
        "ui_permissions": { "$ref": "#/$defs/gate" },
        "menu": { "$ref": "#/$defs/gate" },
        "route_guard": { "$ref": "#/$defs/gate" },
        "forms": { "$ref": "#/$defs/gate" },
        "visual_qa": { "$ref": "#/$defs/gate" },
        "backend_tests": { "$ref": "#/$defs/gate" },
        "frontend_tests": { "$ref": "#/$defs/gate" },
        "runtime_authorization": { "$ref": "#/$defs/gate" },
        "runtime_verification": { "$ref": "#/$defs/gate" },
        "deployment": { "$ref": "#/$defs/gate" }
      }
    },
    "notes": { "type": "string" }
  },
  "$defs": {
    "gate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status"],
      "properties": {
        "status": { "enum": ["required", "na"] },
        "reason": { "type": "string" }
      }
    }
  }
}
