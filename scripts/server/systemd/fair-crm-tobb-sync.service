[Unit]
Description=Fair CRM Weekly TOBB Catalog Synchronization
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=oneshot
User=__DEPLOY_SERVICE_USER__
Group=__DEPLOY_SERVICE_USER__
WorkingDirectory=__FAIR_CRM_DIR__/backend
Environment=PYTHONPATH=__FAIR_CRM_DIR__/backend
EnvironmentFile=-__FAIR_CRM_DIR__/backend/.env
ExecStartPre=/bin/bash -c 'test ! -e "__FAIR_CRM_DIR__/data/restore_maintenance.lock"'
ExecStart=__FAIR_CRM_DIR__/backend/.venv/bin/python -m app.modules.fairs.application.tobb_weekly_sync
